# GEMINI_API_KEY: Required for Google Gemini AI API calls.
# AI Studio injects this from Secrets; add it in Vercel Environment Variables if using Gemini.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Required for Groq AI API calls.
# Configure this server-side only (never expose to VITE_* client env vars).
GROQ_API_KEY="MY_GROQ_API_KEY"

# OPENAI_API_KEY: Required for OpenAI (gpt-4o-mini / gpt-4o) API calls.
# Configure this server-side only in Vercel Environment Variables.
OPENAI_API_KEY="MY_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4o-mini"

# AI_DEFAULT_PROVIDER: Optional primary provider in auto mode ("gemini", "groq", or "openai").
AI_DEFAULT_PROVIDER="gemini"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
